# Copia este archivo como .env.local y completá la clave.
# La misma variable debe configurarse en Vercel (Production y Preview).
# NUNCA subir .env.local al repositorio.

# --- Obligatorio para la guía en línea ---
# Clave de DeepSeek (https://platform.deepseek.com/api_keys).
# La usa api/chat.js; nunca se envía al navegador.
DEEPSEEK_API_KEY=

# --- Límites de uso (opcionales; el código tiene valores por defecto) ---
# Solicitudes por minuto desde una misma IP.
BURST_PER_MINUTE=8
# Tope diario global del proxy (por instancia si no hay Upstash).
DAILY_REQUEST_LIMIT=200
# Tope diario por IP (por instancia).
DAILY_PER_IP_LIMIT=30

# --- Opcional: contador diario global persistente ---
# Creá una base Redis en Vercel > Storage (Upstash) y copiá sus credenciales REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
